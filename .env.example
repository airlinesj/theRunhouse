# ---------------------------------------------------------------------------
# theRunhouse × ABX Motion
# Server-side Firebase access (Admin SDK). Never expose these to the browser.
# ---------------------------------------------------------------------------

# Option A (recommended on Vercel): paste the whole service-account JSON as a
# single-line string. Keep the \n escapes inside private_key.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"docucraft-cd41b",...}

# Option B: individual fields.
FIREBASE_PROJECT_ID=docucraft-cd41b
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option C (local dev only): path to a downloaded service-account key file.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Shared secret for the /api/ingest/* and /api/webhooks/inbound endpoints
# (timing chips, backfills, external providers).
# Send as: Authorization: Bearer <INGEST_API_KEY>
INGEST_API_KEY=

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
# HMAC-SHA256 secret used to sign/verify webhook payloads.
# Inbound:  POST /api/webhooks/inbound  with
#           x-motion-timestamp: <unix seconds>
#           x-motion-signature: hex(HMAC_SHA256(`${timestamp}.${rawBody}`))
# Outbound: delivered as x-motion-signature over `${x-motion-timestamp}.${body}`.
WEBHOOK_SIGNING_SECRET=

# If set, events (run.public.updated, webhook.received, ...) are POSTed here.
# Leave empty to disable outbound delivery.
OUTBOUND_WEBHOOK_URL=
